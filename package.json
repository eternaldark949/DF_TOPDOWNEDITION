{
  "name": "etrnlnine",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node tools/build.js",
    "test": "node --test tests/*.test.js",
    "test:materials": "node tests/materials-browser.cjs",
    "test:bloom": "node tests/bloom-browser.cjs && node tests/bloom-ui-browser.cjs",
    "test:browser": "node tests/browser.cjs",
    "test:studio": "node tests/studio-browser.cjs",
    "test:studio-tools": "node tests/studio-tools-browser.cjs",
    "test:freelancer": "node tests/freelancer-browser.cjs",
    "test:perspective": "ETRNLNINE_PERSPECTIVE=1 node tests/camera-browser.cjs && ETRNLNINE_PERSPECTIVE=1 node tests/studio-tools-browser.cjs && node tests/perspective-render-browser.cjs",
    "test:camera": "node tests/camera-browser.cjs",
    "test:studio-shell": "node tests/studio-shell-browser.cjs",
    "test:viewport-ui": "node tests/viewport-ui-browser.cjs"
  }
}
